# ──────────────────────────────────────────────────────────────────────────────
# Chat-bot O&M — Variáveis de Ambiente
# Copie para .env e preencha. NUNCA versione com valores reais.
# ──────────────────────────────────────────────────────────────────────────────

APP_ENV=development

# ── Banco de dados principal ───────────────────────────────────────────────────
POSTGRES_DB=service_tracker
POSTGRES_USER=chatbot_admin
POSTGRES_PASSWORD=troque_esta_senha

# ── API Keys ───────────────────────────────────────────────────────────────────
API_KEY=troque_esta_chave
# Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_KEY=troque_esta_chave_interna

# ── Tape / scheduler ──────────────────────────────────────────────────────────
TAPE_API_TOKEN=troque_este_token
TAPE_SYNC_SCHEDULE_ENABLED=true
TAPE_SYNC_INTERVAL_HOURS=24
TAPE_SYNC_RUN_ON_STARTUP=false

# ── n8n ────────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=troque_esta_chave
N8N_HEALTH_URL=http://n8n:5678/healthz/readiness
N8N_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/9db5ead4-d4ca-4f5c-a1b4-3969e60cb8df/chat
N8N_GATEWAY_TOKEN=

# ── OIDC / Keycloak ────────────────────────────────────────────────────────────
OIDC_ISSUER_URL=http://localhost:8081/realms/gentil-dev
OIDC_CLIENT_ID=chat-bot-om-bff
# Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
OIDC_CLIENT_SECRET=troque_este_secret_oidc
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# Após o logout o usuário volta para a página /login do frontend.
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/login

# ── Keycloak Admin API (Gestão de Usuários) ────────────────────────────────────
# Client confidencial de serviço, usado SOMENTE pelo backend. O bootstrap DEV o
# cria com os papéis manage-users, view-users, query-users e view-realm.
# Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
KEYCLOAK_ADMIN_CLIENT_ID=chat-bot-om-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=troque_este_secret_admin_api
# Opcional: por padrão derivados de OIDC_ISSUER_URL.
# KEYCLOAK_ADMIN_BASE_URL=http://localhost:8081
# KEYCLOAK_REALM=gentil-dev
# DEV: vincula admin.om, analista.om, gerente.om, diretor.om e convidado.om
# ao aplicativo (ativos, com o perfil correspondente). Ignorado fora de development.
DEV_PROVISION_USERS=true

# ── SMTP do Keycloak (opcional) ────────────────────────────────────────────────
# Com SMTP configurado, o login exibe "Esqueci minha senha" e a Gestão de
# Usuários pode enviar o e-mail de definição de senha (UPDATE_PASSWORD).
# Sem SMTP, o cadastro usa senha temporária (troca obrigatória no 1º acesso).
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=Chat-bot O&M
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false

# ── Sessão ─────────────────────────────────────────────────────────────────────
# Gere: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=troque_este_secret_de_sessao
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://frontend:5173

# ── Bootstrap admin ───────────────────────────────────────────────────────────
# DEV: DEV_ADMIN_EMAIL é a referência efetiva de bootstrap para evitar divergência
# entre o usuário do Keycloak local e o backend.
# PROD: defina BOOTSTRAP_ADMIN_EMAIL explicitamente para o primeiro administrador.
BOOTSTRAP_ADMIN_EMAIL=

# ── Keycloak DEV ───────────────────────────────────────────────────────────────
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=troque_esta_senha_keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=troque_esta_senha_admin_keycloak

# ── Usuários DEV (sincronizados automaticamente no Keycloak local) ────────────
DEV_ADMIN_EMAIL=admin.om@local
DEV_ANALYST_EMAIL=analista.om@local
DEV_MANAGER_EMAIL=gerente.om@local
DEV_DIRECTOR_EMAIL=diretor.om@local
DEV_GUEST_EMAIL=convidado.om@local
DEV_ADMIN_PASSWORD=troque_esta_senha_dev_admin
DEV_ANALYST_PASSWORD=troque_esta_senha_dev_analyst
DEV_MANAGER_PASSWORD=troque_esta_senha_dev_manager
DEV_DIRECTOR_PASSWORD=troque_esta_senha_dev_director
DEV_GUEST_PASSWORD=troque_esta_senha_dev_guest

# ── Frontend ───────────────────────────────────────────────────────────────────
# DEV/BFF: manter vazio. Todas as chamadas do browser usam caminhos relativos e passam pelo proxy/reverse proxy.
VITE_BACKEND_URL=
# VITE_N8N_WEBHOOK_URL REMOVIDO — o frontend não chama o n8n diretamente.
