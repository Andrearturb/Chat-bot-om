        "supplier",
        "requester",
        "category",
        "subcategory",
        "missing_field",
        "group_by",
        "limit"
      ],
      "oracle": {
        "type": "count",
        "sql": "SELECT COUNT(*) AS total FROM services WHERE created_on >= '2026-08-10' AND created_on < '2026-08-21';"
