{
  "id": "missing-to-supplier",
  "name": "Sem fornecedor para fornecedor específico",
  "category": "supplier",
  "steps": [
    {
      "message": "Quantos chamados estão em atendimento sem fornecedor?",
      "expected_state": {
        "event": "current_status",
        "statuses": [
          "Em atendimento"
        ],
        "missing_field": "supplier"
      },
      "must_be_null": [
        "supplier",
        "analyst_responsible",
        "requester",
        "status",
        "store_name",
        "praca",
        "location_term",
        "date_field",
        "year",
        "month",
        "start_date",
        "end_date",
        "group_by",
        "limit"
      ],
      "oracle": {
        "type": "count",
        "sql": "SELECT COUNT(*) AS total FROM services WHERE status = 'Em atendimento' AND (supplier IS NULL OR BTRIM(supplier) = '');"
      }
    },
    {
      "message": "mostre os chamados",
      "expected_state": {
        "event": "current_status",
        "statuses": [
          "Em atendimento"
        ],
        "missing_field": "supplier"
      },
      "must_be_null": [
        "supplier",
        "analyst_responsible",
        "requester",
        "status",
        "store_name",
        "praca",
        "location_term",
        "date_field",
        "year",
        "month",
        "start_date",
        "end_date",
        "group_by",
        "limit"
      ],
      "oracle": {
        "type": "tickets",
        "sql": "SELECT ticket FROM services WHERE status = 'Em atendimento' AND (supplier IS NULL OR BTRIM(supplier) = '') ORDER BY ticket;"
      }
    },
    {
      "message": "e quantos com o fornecedor 43.449.745/0001-45 - GB SERVICOS E REFRIGERACAO LTDA?",
      "expected_state": {
        "event": "current_status",
        "supplier": "43.449.745/0001-45 - GB SERVICOS E REFRIGERACAO LTDA",
        "statuses": [
          "Em atendimento"
        ]
      },
      "must_be_null": [
        "missing_field",
        "analyst_responsible",
        "requester",
        "status",
        "store_name",
        "praca",
        "location_term",
        "date_field",
        "year",
        "month",
        "start_date",
        "end_date",
        "group_by",
        "limit"
      ],
      "oracle": {
        "type": "count",
        "sql": "SELECT COUNT(*) AS total FROM services WHERE status = 'Em atendimento' AND LOWER(BTRIM(supplier)) = LOWER(BTRIM('43.449.745/0001-45 - GB SERVICOS E REFRIGERACAO LTDA'));"
      }
    },
    {
      "message": "mostre os chamados",
      "expected_state": {
        "event": "current_status",
        "supplier": "43.449.745/0001-45 - GB SERVICOS E REFRIGERACAO LTDA",
        "statuses": [
          "Em atendimento"
        ]
      },
      "must_be_null": [
        "missing_field",
        "analyst_responsible",
        "requester",
        "status",
        "store_name",
        "praca",
        "location_term",
        "date_field",
        "year",
        "month",
        "start_date",
        "end_date",
        "group_by",
        "limit"
      ],
      "oracle": {
        "type": "tickets",
        "sql": "SELECT ticket FROM services WHERE status = 'Em atendimento' AND LOWER(BTRIM(supplier)) = LOWER(BTRIM('43.449.745/0001-45 - GB SERVICOS E REFRIGERACAO LTDA')) ORDER BY ticket;"
      }
    }
  ]
}